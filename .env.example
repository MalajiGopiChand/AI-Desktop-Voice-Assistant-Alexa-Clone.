# === REQUIRED ===
# Groq LLM brain — https://console.groq.com (free tier)
GROQ_API_KEY=your_groq_api_key_here

# === OPTIONAL ===
JARVIS_USERNAME=Gopi
JARVIS_CITY=Mumbai

# Weather — https://openweathermap.org/api (free tier)
OPENWEATHER_API_KEY=

# News — https://newsapi.org (free tier; RSS works without key)
NEWS_API_KEY=

# Offline wake word — https://console.picovoice.ai (free tier)
PICOVOICE_ACCESS_KEY=
USE_PORCUPINE=false

# Google Calendar — place credentials.json in project root, then run:
#   python scripts/auth_google_calendar.py
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# Chrome profile path for Playwright persistent sessions (optional)
CHROME_USER_DATA=
